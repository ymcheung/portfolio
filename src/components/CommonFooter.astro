---
import ThemeToggle from './ThemeToggle.svelte';
import Icon from './Icons.astro';
import { AUTHOR } from '../lib/site';

type Props = {
  locale: 'en' | 'zh-TW';
  langHref?: string;
};

const { locale, langHref: providedLangHref } = Astro.props;
const currentYear = new Date().getFullYear();
const otherLocale = locale === 'en' ? 'zh-TW' : 'en';
const langHref = providedLangHref ?? (locale === 'en' ? '/zh-TW/' : '/');
const langLabel = locale === 'en' ? '中文' : 'English';
---

<footer class="mbs-2 mx-auto px-4 pb-8 min-[992px]:max-w-[960px] min-[1200px]:max-w-[1168px]">
  <div>
    <hr class="ml-0 mr-auto w-30 border-0 border-b border-solid border-b-[hsl(var(--footer-separate))]" />
    <div class="mbs-4">
      <strong class="mr-2 font-sans text-[18px] font-bold italic text-[hsl(var(--shade-100))]">{AUTHOR}</strong>
      <span class="font-sans text-[14px] text-[hsl(var(--shade-600))]">{currentYear}</span>
    </div>
    <div class="mt-0 grid h-12 grid-flow-col auto-cols-max items-center gap-2">
      <ThemeToggle client:load />
      <a href={langHref} hreflang={otherLocale} class="inline-flex h-7 items-center rounded bg-[hsl(var(--shade-1500))] px-2 font-sans text-sm leading-none text-[hsl(var(--shade-600))] transition-colors hover:bg-[hsl(var(--shade-1400))]">
        <Icon name="lang" />
        <span class="ms-1">{langLabel}</span>
      </a>
    </div>
  </div>
</footer>
