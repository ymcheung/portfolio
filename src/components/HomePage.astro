---
import ThemeToggle from './ThemeToggle.svelte';
import Icon from './Icons.astro';
import BannerBuildUI from './BannerBuildUI.astro';
import { AUTHOR, DESCRIPTION } from '../lib/site';

type Props = {
  locale: 'en' | 'zh-TW';
  projectTitle: string;
};

const { locale, projectTitle } = Astro.props;
const currentYear = new Date().getFullYear();
const otherLocale = locale === 'en' ? 'zh-TW' : 'en';
const langHref = locale === 'en' ? '/zh-TW/' : '/';
const langLabel = locale === 'en' ? '中文' : 'English';
---

<div class="min-h-screen bg-[hsl(var(--shade-1600))] text-[hsl(var(--shade-100))]">
  <header class="relative min-h-40 overflow-hidden border-b-2 border-[hsl(var(--shade-1400))] pt-12 md:min-h-48">
    <div class="mx-auto px-4 min-[992px]:max-w-[960px] min-[1200px]:max-w-[1168px]">
      <strong class="relative z-10 -ml-0.5 inline-block font-sans text-[20px] font-extrabold italic leading-normal text-[hsl(var(--shade-0))]">
        {AUTHOR}
      </strong>
      <h1 class="relative z-10 m-0 max-w-[600px] font-sans text-[28px] font-normal italic leading-normal text-[hsl(var(--shade-600))]">
        {DESCRIPTION}
      </h1>
    </div>
    <div class="absolute inset-x-0 bottom-0 z-0 h-[140px] animate-[cans_36s_linear_infinite] bg-[url('/home/cans.svg')] bg-[length:120px_120px] after:absolute after:inset-x-0 after:bottom-0 after:h-[140px] after:bg-gradient-to-b after:from-[hsl(var(--shade-1600))] after:to-transparent motion-reduce:animate-none"></div>
  </header>

  <main class="mx-auto mbs-8 px-4 min-[992px]:max-w-[960px] min-[1200px]:max-w-[1168px]">
    <section aria-labelledby="projects-title">
      <h2 id="projects-title" class:list={[
        'm-0 mb-3 font-sans text-[18px] font-extrabold leading-normal tracking-[1px] text-[hsl(var(--shade-700))]',
        locale === 'en' && 'italic',
      ]}>
        {projectTitle}
      </h2>
    </section>
  </main>

  <aside class="mbs-12 mx-auto grid grid-cols-[48px_192px] items-center gap-3 px-4 min-[992px]:max-w-[960px] min-[1200px]:max-w-[1168px]">
    <a class="-ms-2" href="https://github.com/ymcheung" target="_blank" rel="noopener" aria-label="Github Profile">
      <Icon name="github" />
    </a>
    <a href="https://build.intersection.tw" target="_blank" rel="noopener">
      <BannerBuildUI />
    </a>
  </aside>

  <footer class="mbs-2 mx-auto px-4 pb-8 min-[992px]:max-w-[960px] min-[1200px]:max-w-[1168px]">
    <div>
      <hr class="ml-0 mr-auto w-30 border-0 border-b border-solid border-b-[hsl(var(--footer-separate))]" />
      <div class="mbs-4">
        <strong class="mr-2 font-sans text-[18px] font-bold italic text-[hsl(var(--shade-100))]">{AUTHOR}</strong>
        <span class="font-sans text-[14px] text-[hsl(var(--shade-600))]">{currentYear}</span>
      </div>
      <div class="mt-0 grid h-12 grid-flow-col auto-cols-max items-center gap-2">
        <ThemeToggle client:load />
        <a href={langHref} hreflang={otherLocale} class="inline-flex h-7 items-center rounded bg-[hsl(var(--shade-1500))] px-2 font-sans text-sm leading-none text-[hsl(var(--shade-600))] transition-colors hover:bg-[hsl(var(--shade-1400))]">
          <Icon name="lang" />
          <span class="ms-1">{langLabel}</span>
        </a>
      </div>
    </div>
  </footer>
</div>
