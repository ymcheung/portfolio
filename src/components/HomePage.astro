---
import Icon from './Icons.astro';
import BannerBuildUI from './BannerBuildUI.astro';
import CommonFooter from './CommonFooter.astro';
import { AUTHOR, DESCRIPTION } from '../lib/site';

type Props = {
  locale: 'en' | 'zh-TW';
  projectTitle: string;
};

const { locale, projectTitle } = Astro.props;
---

<div class="min-h-screen bg-[hsl(var(--shade-1600))] text-[hsl(var(--shade-100))]">
  <header class="relative min-h-40 overflow-hidden border-b-2 border-[hsl(var(--shade-1400))] pt-12 md:min-h-48">
    <div class="mx-auto px-4 min-[992px]:max-w-240 min-[1200px]:max-w-292">
      <strong class="relative z-10 -ml-0.5 inline-block font-sans text-[20px] font-extrabold italic leading-normal text-[hsl(var(--shade-0))]">
        {AUTHOR}
      </strong>
      <h1 class="relative z-10 m-0 max-w-150 font-sans text-[28px] font-normal italic leading-normal text-[hsl(var(--shade-600))]">
        {DESCRIPTION}
      </h1>
    </div>
    <div class="absolute inset-x-0 bottom-0 z-0 h-35 animate-[cans_36s_linear_infinite] bg-[url('/home/cans.svg')] bg-[length:120px_120px] after:absolute after:inset-x-0 after:bottom-0 after:h-35 after:bg-gradient-to-b after:from-[hsl(var(--shade-1600))] after:to-transparent motion-reduce:animate-none"></div>
  </header>

  <main class="mx-auto mbs-8 px-4 min-[992px]:max-w-[960px] min-[1200px]:max-w-[1168px]">
    <section aria-labelledby="projects-title">
      <h2 id="projects-title" class:list={[
        'm-0 font-sans text-[18px] font-extrabold leading-normal tracking-[1px] text-[hsl(var(--shade-700))]',
        locale === 'en' && 'italic',
      ]}>
        {projectTitle}
      </h2>
    </section>
  </main>

  <aside class="mbs-12 mx-auto grid grid-cols-[48px_192px] items-center gap-3 px-4 min-[992px]:max-w-[960px] min-[1200px]:max-w-[1168px]">
    <a class="-ms-2" href="https://github.com/ymcheung" target="_blank" rel="noopener" aria-label="Github Profile">
      <Icon name="github" />
    </a>
    <a href="https://build.intersection.tw" target="_blank" rel="noopener">
      <BannerBuildUI />
    </a>
  </aside>

  <CommonFooter locale={locale} />
</div>
